# app.js reads process environment; this file is not loaded automatically.
NODE_ENV=development
# Generate a private secret; required (32+ characters) in production.
SESSION_SECRET=
# Mail stays disabled until all four values are supplied.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_PORT=587
SMTP_SECURE=

# Production defaults to a same-host HTTPS proxy only.
TRUST_PROXY=
